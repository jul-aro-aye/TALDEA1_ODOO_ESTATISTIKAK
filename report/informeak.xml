            <field name="report_name">jatetxeko_estatistikak.report_eskaerak_hileko_eguna</field>
            <field name="report_file">jatetxeko_estatistikak.report_eskaerak_hileko_eguna</field>
            <field name="binding_model_id" ref="model_jatetxeko_eskaera"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_style">
            <style>
                table.jatetxeko-report {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 12px;
                }
                table.jatetxeko-report th,
                table.jatetxeko-report td {
                    border: 1px solid #d8d8d8;
                    padding: 6px;
                }
                table.jatetxeko-report th {
                    background: #f2f2f2;
                    font-weight: bold;
                }
                .jatetxeko-muted {
                    color: #666;
                    font-size: 11px;
                    margin-bottom: 16px;
                }
                .jatetxeko-number {
                    text-align: right;
                }
            </style>
        </template>

        <template id="report_zerbitzariak">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-call="jatetxeko_estatistikak.report_style"/>
                    <h2>Zerbitzarien txostena</h2>
                    <p class="jatetxeko-muted">Erregistro kopurua: <span t-esc="len(docs)"/></p>
                    <table class="jatetxeko-report">
                        <thead>
                            <tr>
                                <th>Izena</th>
                                <th>Posta elektronikoa</th>
                                <th>Rola</th>
                                <th>Txata</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc">
                                <td><span t-esc="doc.name"/></td>
                                <td><span t-esc="doc.emaila or ''"/></td>
                                <td><span t-esc="doc.rola_izena or ''"/></td>
                                <td><span t-esc="'Bai' if doc.txat else 'Ez'"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </t>
        </template>

        <template id="report_platerak">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-call="jatetxeko_estatistikak.report_style"/>
                    <h2>Plateren txostena</h2>
                    <p class="jatetxeko-muted">Erregistro kopurua: <span t-esc="len(docs)"/></p>
                    <table class="jatetxeko-report">
                        <thead>
                            <tr>
                                <th>Izena</th>
                                <th>Prezioa</th>
                                <th>API kategoria</th>
                                <th>Uneko stocka</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc">
                                <td><span t-esc="doc.name"/></td>
                                <td class="jatetxeko-number"><span t-esc="'%.2f' % doc.prezioa"/></td>
                                <td class="jatetxeko-number"><span t-esc="doc.kategoria_id"/></td>
                                <td class="jatetxeko-number"><span t-esc="doc.stock_aktuala"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </t>
        </template>

        <template id="report_mahaiak">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-call="jatetxeko_estatistikak.report_style"/>
                    <h2>Mahaien txostena</h2>
                    <p class="jatetxeko-muted">Erregistro kopurua: <span t-esc="len(docs)"/></p>
                    <table class="jatetxeko-report">
                        <thead>
                            <tr>
                                <th>Izena</th>
                                <th>Zenbakia</th>
                                <th>Edukiera</th>
                                <th>Egoera</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc">
                                <td><span t-esc="doc.name"/></td>
                                <td class="jatetxeko-number"><span t-esc="doc.zenbakia"/></td>
                                <td class="jatetxeko-number"><span t-esc="doc.kapazitatea"/></td>
                                <td><span t-esc="doc.egoera or ''"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </t>
        </template>

        <template id="report_eskaerak">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-call="jatetxeko_estatistikak.report_style"/>
                    <h2>Eskaeren txostena</h2>
                    <p class="jatetxeko-muted">Erregistro kopurua: <span t-esc="len(docs)"/></p>
                    <table class="jatetxeko-report">
                        <thead>
                            <tr>
                                <th>Izena</th>
                                <th>Zerbitzaria</th>
                                <th>Mahaia</th>
                                <th>Komentsalak</th>
                                <th>Egoera</th>
                                <th>Txanda</th>
                                <th>Data</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc">
                                <td><span t-esc="doc.name"/></td>
                                <td><span t-esc="doc.zerbitzaria_id.name or ''"/></td>
                                <td><span t-esc="doc.mahaia_id.name or ''"/></td>
                                <td class="jatetxeko-number"><span t-esc="doc.komensalak"/></td>
                                <td><span t-esc="doc.egoera or ''"/></td>
                                <td><span t-esc="doc.txanda or ''"/></td>
                                <td><span t-field="doc.sortze_data"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </t>
        </template>

        <template id="report_fakturak">
            <t t-call="web.html_container">
