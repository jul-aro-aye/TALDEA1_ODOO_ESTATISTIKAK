                                <th>Eskaera</th>
                                <th>Data</th>
                                <th>Guztira</th>
                                <th>PDF fitxategia</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc">
                                <td><span t-esc="doc.name"/></td>
                                <td><span t-esc="doc.eskaera_id.name or ''"/></td>
                                <td><span t-field="doc.data"/></td>
                                <td class="jatetxeko-number"><span t-esc="'%.2f' % doc.totala"/></td>
                                <td><span t-esc="doc.pdf_izena or ''"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </t>
        </template>

